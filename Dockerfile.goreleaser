# Packages the binary GoReleaser already built; nothing is compiled here.
#
# A static base is possible because dr-sync's xz implementation is pure Go: there is no
# system `xz` to depend on, and nothing to link against.
FROM cgr.dev/chainguard/static:latest@sha256:fe55470f22d3259488d9d3739168d8f04da67755f0b69382bc26eda4a7d3d327

# dockers_v2 stages each platform's binary under $TARGETPLATFORM, unlike the legacy
# `dockers:` block which copies from the build context root.
ARG TARGETPLATFORM
COPY $TARGETPLATFORM/dr-sync /dr-sync

ENTRYPOINT ["/dr-sync"]
